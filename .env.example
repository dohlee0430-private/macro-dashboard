# === 필수 아님: 없어도 대시보드 기본 기능 동작 ===
# 아래 API 키가 없으면 해당 섹션만 "API 키 필요" 표시

# FRED API (미국 M2, CPI, 실업률, 국채 스프레드)
# 무료 발급: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Bank of Korea API (한국 M2 통화량)
# 무료 발급: https://ecos.bok.or.kr/api/ → 인증키 신청
BOK_API_KEY=your_bok_api_key_here

# 공공데이터포털 (부동산 실거래가, 아파트가격동향)
# 무료 발급: https://www.data.go.kr → 회원가입 → 활용신청
# 신청 API: "국토교통부 아파트매매 실거래 상세 자료"
DATA_GO_KR_API_KEY=your_data_go_kr_api_key_here
